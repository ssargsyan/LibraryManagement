@model LibraryMvc.Models.BookFormViewModel

<div class="min-h-screen bg-slate-100 py-10">

    <div class="max-w-2xl mx-auto">

        <div class="bg-white rounded-3xl shadow-xl p-8">

            <!-- Header -->

            <div class="mb-8">
                <h1 class="text-3xl font-bold text-slate-800">
                    @ViewData["PageTitle"]
                </h1>

                <p class="text-slate-500 mt-2">
                    @ViewData["Title"]
                </p>
            </div>
            @* <partial name="_BookForm" model="Model" /> *@

            <form asp-action="@ViewData["FormAction"]" method="post" class="space-y-6">

                @if (Model.Id > 0)
                {
                    <input type="hidden" asp-for="Id" />
                }
                <!-- Title -->

                <div>

                    <label asp-for="Title" class="block text-sm font-semibold text-slate-700 mb-2">
                        Book Title
                    </label>


                    <input asp-for="Title" class="
                    w-full
                    px-4
                    py-3
                    rounded-xl
                    border
                    border-slate-300
                    focus:ring-2
                    focus:ring-blue-500
                    focus:border-blue-500
                    outline-none
                    transition" />


                    <span asp-validation-for="Title" class="text-red-500 text-sm">
                    </span>

                </div>



                <!-- Author -->


                <div>

                    <label asp-for="Author" class="block text-sm font-semibold text-slate-700 mb-2">
                        Author
                    </label>

                    <input asp-for="Author" class="
                    w-full
                    px-4
                    py-3
                    rounded-xl
                    border
                    border-slate-300
                    focus:ring-2
                    focus:ring-blue-500
                    focus:border-blue-500
                    outline-none
                    transition" />


                    <span asp-validation-for="Author" class="text-red-500 text-sm">
                    </span>



                  

                </div>



                <!-- Buttons -->


                <div class="flex justify-end gap-4 pt-6">


                    <a asp-action="Index" class="
                        px-6
                        py-3
                        rounded-xl
                        bg-slate-200
                        text-slate-700
                        hover:bg-slate-300
                        transition">

                        Cancel

                    </a>



                    <button type="submit" class="
                        px-6
                        py-3
                        rounded-xl
                        bg-blue-600
                        text-white
                        hover:bg-blue-700
                        shadow
                        transition">

                        @ViewData["ButtonText"]

                    </button>


                </div>


            </form>

        </div>

    </div>

</div>
