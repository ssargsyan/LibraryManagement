<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Management</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-100 min-h-screen">
    <div class="layout">
        <aside class="sidebar">
            <nav class="bg-slate-900 text-white shadow-lg">
                <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between">
                    <div class="text-2xl font-bold">
                        📚 LibraryMS
                    </div>
                    @{
                        var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
                        var action = ViewContext.RouteData.Values["Action"]?.ToString();
                    }
                    <div class="space-x-6">
                        <a asp-controller="Home" asp-action="Index"
                           class="@(controller == "Home" ? "text-blue-400 border-b-2 border-blue-400" : "text-gray-300 hover:text-white transition")">
                            Home
                        </a>
                        <a asp-controller="Books" asp-action="Index"
                           class="@(controller == "Books" && action == "Index" ? "text-blue-400 border-b-2 border-blue-400" : "text-gray-300 hover:text-white transition")">
                            Books
                        </a>
                        <a asp-controller="Books" asp-action="Create"
                           class="@(controller == "Books" && action == "Create" ? "text-blue-400 border-b-2 border-blue-400" : "text-gray-300 hover:text-white transition")">
                            Add New Book
                        </a>
                        <a asp-controller="Authors" asp-action="Index"
                           class="@(controller == "Authors" ? "text-blue-400 border-b-2 border-blue-400" : "text-gray-300 hover:text-white transition")">
                            Authors
                        </a>
                    </div>
                </div>
            </nav>
        </aside>
        <main class=" main-content mt-2">
            <div class="content-container">
                @RenderBody()
            </div>
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>